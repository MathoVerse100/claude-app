{
  "app": {
    "name": "DataVerse",
    "default_locale": "en",
    "locales": [
      {
        "code": "en",
        "label": "EN",
        "name": "English",
        "dir": "ltr"
      },
      {
        "code": "es",
        "label": "ES",
        "name": "Español",
        "dir": "ltr"
      },
      {
        "code": "ar",
        "label": "AR",
        "name": "العربية",
        "dir": "rtl"
      }
    ]
  },
  "cookies": {
    "token": "dv_token",
    "lang": "dv_lang",
    "theme": "dv_theme",
    "max_age_days": 365
  },
  "features": {
    "hero_art": true,
    "metrics_preview": true
  },
  "metrics": {
    "default_range": "7d",
    "ranges": [
      "24h",
      "7d",
      "30d"
    ]
  },
  "direction": {
    "force": null,
    "default": "ltr",
    "_help": "force: null | \"ltr\" | \"rtl\". When set, every locale uses that direction (e.g. \"rtl\" to flip the UI even for English). When null, each locale's own `dir` is used."
  },
  "hero_art": {
    "scenes": [
      "bars",
      "waves"
    ],
    "hold_seconds": 10,
    "fade_seconds": 1.8
  }
}
