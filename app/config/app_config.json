{
  "app": {
    "name": "DataVerse",
    "default_locale": "en",
    "locales": [
      { "code": "en", "label": "EN", "name": "English" },
      { "code": "es", "label": "ES", "name": "Español" }
    ]
  },
  "cookies": {
    "token": "dv_token",
    "lang": "dv_lang",
    "theme": "dv_theme",
    "max_age_days": 365
  },
  "features": {
    "mesh_graphics": true,
    "metrics_preview": true
  },
  "metrics": {
    "default_range": "7d",
    "ranges": ["24h", "7d", "30d"]
  }
}
